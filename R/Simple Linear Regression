install.packages("readxl")
library(readxl)
setwd("")
mydata <- read_excel("sleep75.xls", sheet = 1, col_names = FALSE)
sleep_model <- lm(mydata$...21 ~ mydata$...26)
summary(sleep_model)
n <- nrow(mydata)
k <- 2 
df <- n - k
residuals_sq_sum <- sum(resid(sleep_model)^2)
residual_std_error <- sqrt(residuals_sq_sum / df)
print(paste("Degrees of Freedom:", df))
print(paste("Residual Standard Error:", residual_std_error)) 
