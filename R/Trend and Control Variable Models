library(readxl)
library(lmtest)
setwd(" ")
mydata_inv <- read_excel("hseinv.xls", sheet = 1, col_names = FALSE)
colnames(mydata_inv) <- paste0("X", 1:ncol(mydata_inv))
plot(mydata_inv$X1, mydata_inv$X10, type = "l", col = "red", ylim = c(-1, 0), xlab = "Time", ylab = "Log Investment / Price")
lines(mydata_inv$X1, mydata_inv$X7, col = "green")

lm_inv1 <- lm(X10 ~ X7, data = mydata_inv)
summary(lm_inv1)

lm_inv2 <- lm(X10 ~ X7 + X8, data = mydata_inv)
summary(lm_inv2)

mydata_wge <- read_excel("prminwge.xls", sheet = 1, col_names = FALSE)
colnames(mydata_wge) <- paste0("X", 1:ncol(mydata_wge))

lm_wge_notrend <- lm(X21 ~ X24 + X18, data = mydata_wge)
summary(lm_wge_notrend)

lm_wge_trend <- lm(X21 ~ X24 + X18 + X14, data = mydata_wge)
summary(lm_wge_trend)
