library(readxl)
library(lmtest)
setwd("")
mydata <- read_excel("hprice1.xls", sheet = 1, col_names = FALSE)
colnames(mydata) <- paste0("X", 1:ncol(mydata))

lm1 <- lm(X1 ~ X4 + X5 + X3, data = mydata)
summary(lm1)
lm2 <- lm(resid(lm1)^2 ~ X4 + X5 + X3, data = mydata)
summary(lm2)
bptest(X1 ~ X4 + X5 + X3, data = mydata)


lm3 <- lm(X7 ~ X9 + X10 + X3, data = mydata)
summary(lm3)
lm4 <- lm(resid(lm3)^2 ~ X9 + X10 + X3, data = mydata)
summary(lm4)
bptest(X7 ~ X9 + X10 + X3, data = mydata) 
